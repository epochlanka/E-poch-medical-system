# Production image: static Vite build served by nginx.
# Dev keeps using ./Dockerfile (vite dev server) — this is only for real deployment.

FROM node:24-alpine AS builder
WORKDIR /usr/src/app

COPY pharmacist-frontend/package*.json ./pharmacist-frontend/
RUN cd pharmacist-frontend && npm ci

COPY pharmacist-frontend ./pharmacist-frontend
COPY shared ./shared
WORKDIR /usr/src/app/pharmacist-frontend
RUN npm run build

# ---

FROM nginx:1.27-alpine
COPY --from=builder /usr/src/app/pharmacist-frontend/dist /usr/share/nginx/html
COPY pharmacist-frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
