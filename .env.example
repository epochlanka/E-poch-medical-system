# Repo-root settings read by docker-compose.prod.yml (not the backend — that has backend/.env).
#
# The address workstations type into the browser: this server's LAN IP or hostname, e.g. the doctor's PC
# opens http://192.168.1.50:5174. The allowed portal origins are derived from it. Give the server a
# fixed IP (router DHCP reservation) so this never changes.
SITE_HOST=192.168.1.50
