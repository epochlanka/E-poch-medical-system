# Repo-root settings read by docker-compose.prod.yml (not the backend — that has backend/.env).
#
# The address workstations type into the browser: this server's LAN IP or hostname. Everyone opens
# http://<SITE_HOST>:5173 and signs in; the workspace that loads follows their role. The allowed
# browser origin is derived from this. Give the server a fixed IP (router DHCP reservation) so it
# never changes.
SITE_HOST=192.168.1.50
