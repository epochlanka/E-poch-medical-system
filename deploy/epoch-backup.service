## Runs backup.sh once (triggered daily by epoch-backup.timer).
##
## __REPO_PATH__ is whichever directory holds the compose file and backup.sh: the repository root
## on a development machine, or the transferred install folder on the clinic machine.
## Set BACKUP_DEST (and ideally BACKUP_PASSPHRASE_FILE) in the .env or clinic.env beside it.
##
## On the clinic machine, from inside the install folder:
##   sudo cp epoch-backup.service epoch-backup.timer /etc/systemd/system/
##   sudo sed -i "s#__REPO_PATH__#$(pwd)#" /etc/systemd/system/epoch-backup.service
##   sudo sed -i "s#/deploy/backup.sh#/backup.sh#" /etc/systemd/system/epoch-backup.service
##   sudo systemctl daemon-reload
##   sudo systemctl enable --now epoch-backup.timer

[Unit]
Description=E-Poch Medical System backup (one-shot, run by epoch-backup.timer)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=__REPO_PATH__
ExecStart=__REPO_PATH__/deploy/backup.sh
TimeoutStartSec=3600
