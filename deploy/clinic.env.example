# Copy this file to clinic.env beside docker-compose.yml on the clinic machine.
# Do not share the completed file: it contains database and login secrets.

# Fixed LAN address of the Ubuntu clinic machine.
SITE_HOST=192.168.1.50
NODE_ENV=production
PORT=3000
TZ=Asia/Colombo
COOKIE_SECURE=false

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL runs on this machine as the `db` service in docker-compose.yml. It is reachable only
# from the application over the private compose network, never from the clinic LAN.
#
# Set POSTGRES_PASSWORD to a long random value and put THE SAME value in both URLs below.
# Generate one with:  openssl rand -hex 24
# If the password contains characters other than letters and digits, URL-encode them in the URLs.
POSTGRES_DB=epoch
POSTGRES_USER=epoch
POSTGRES_PASSWORD=CHANGE_ME_run_openssl_rand_hex_24

# Host is the compose service name `db`, not localhost — the app runs in its own container.
DATABASE_URL=postgresql://epoch:CHANGE_ME_run_openssl_rand_hex_24@db:5432/epoch?connection_limit=10
DIRECT_URL=postgresql://epoch:CHANGE_ME_run_openssl_rand_hex_24@db:5432/epoch

# The startup security check looks for Supabase's public API roles (anon / authenticated) and is
# meaningless on a plain PostgreSQL where they do not exist. Leave this true for a local database.
SKIP_DB_SECURITY_CHECK=true

# Generate once with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48

# Optional ICD-11 diagnosis search.
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# Logging and optional email alerts.
APP_VERSION=1.0.0
SERVICE_NAME=epoch-backend
LOG_LEVEL=info
ERROR_ALERT_EMAIL=
ERROR_ALERT_FROM="E-POCH Error Monitor <no-reply@epoch.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ERROR_ALERT_WINDOW_MS=600000
ERROR_ALERT_MAX_PER_HOUR=20
