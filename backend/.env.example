# ── E-POCH Medical System · backend environment ─────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored and never shipped to the frontend.

# ── Core ───────────────────────────────────────────────────────────────────────
DATABASE_URL=file:./dev.db
# Required. Generate a unique value, for example: openssl rand -base64 48
JWT_SECRET=
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ── ICD-11 (diagnosis lookup) ──────────────────────────────────────────────────
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# ── Error handling & monitoring ────────────────────────────────────────────────
# App version shown in logs / alert emails (defaults to package.json "version").
APP_VERSION=1.0.0
# Logical name of this backend service, used in logs and alert emails.
SERVICE_NAME=epoch-backend
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Newline-delimited JSON copy of every error, for `grep ERR-YYYYMMDD-NNNNNN <file>`.
# Defaults to backend/logs/errors.log (gitignored).
ERROR_LOG_FILE=

# Where admin error alerts are sent.
ERROR_ALERT_EMAIL=epochadminlk@gmail.com
# From header for alert emails (defaults to SMTP_USER).
ERROR_ALERT_FROM=E-POCH Error Monitor <no-reply@epoch.local>

# SMTP transport for alert emails. If HOST/USER/PASS are blank, alerting degrades to
# "log only" — the app still runs, errors are still logged, no email is attempted.
# For Gmail use an App Password (not the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Flood control for alert emails.
# One email per distinct error per this window (ms); occurrences are still all logged.
ERROR_ALERT_WINDOW_MS=600000
# Hard cap on alert emails across all errors per rolling hour.
ERROR_ALERT_MAX_PER_HOUR=20
