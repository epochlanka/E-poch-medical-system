# ── E-POCH Medical System · backend environment ─────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored and never shipped to the frontend.

# ── Core ───────────────────────────────────────────────────────────────────────
# Supabase Postgres. From Supabase dashboard > Connect (or Project Settings > Database) >
# Connection string > "Session pooler". The direct host (db.<ref>.supabase.co) is IPv6-only and
# often unreachable (many hosts/containers have no IPv6 route), so use the pooler for both vars.
# connection_limit caps this process's pool — Prisma otherwise defaults to num_cpus*2+1 per
# PrismaClient instance, which can exceed Supabase's shared pooler connection limit.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres?connection_limit=10
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
# Required. Generate a unique value, for example: openssl rand -base64 48
JWT_SECRET=
PORT=3000
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed to send the shared authentication cookie.
# For a multi-PC LAN deployment, include the exact origin each PC uses to reach this server —
# e.g. http://192.168.1.50:5174 for a doctor's PC on another machine — not just localhost.
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
NODE_ENV=development
# Secure (HTTPS-only) by default in production; see the LAN note at the bottom of this file.
COOKIE_SECURE=true

# ── ICD-11 (diagnosis lookup) ──────────────────────────────────────────────────
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# ── Error handling & monitoring ────────────────────────────────────────────────
# App version shown in logs / alert emails (defaults to package.json "version").
APP_VERSION=1.0.0
# Logical name of this backend service, used in logs and alert emails.
SERVICE_NAME=epoch-backend
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Newline-delimited JSON copy of every error, for `grep ERR-YYYYMMDD-NNNNNN <file>`.
# Defaults to backend/logs/errors.log (gitignored).
ERROR_LOG_FILE=

# Where admin error alerts are sent.
ERROR_ALERT_EMAIL=epochadminlk@gmail.com
# From header for alert emails (defaults to SMTP_USER).
ERROR_ALERT_FROM=E-POCH Error Monitor <no-reply@epoch.local>

# SMTP transport for alert emails. If HOST/USER/PASS are blank, alerting degrades to
# "log only" — the app still runs, errors are still logged, no email is attempted.
# For Gmail use an App Password (not the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Flood control for alert emails.
# One email per distinct error per this window (ms); occurrences are still all logged.
ERROR_ALERT_WINDOW_MS=600000
# Hard cap on alert emails across all errors per rolling hour.
ERROR_ALERT_MAX_PER_HOUR=20

# ── Deployment on the clinic's local network (plain HTTP) ─────────────────────────────────────
# Set SITE_HOST in the repo-root .env (docker-compose passes it here) and the allowed portal origins
# follow from it. Only set FRONTEND_URLS for something unusual (extra hostnames, TLS in front).
#
# The login cookie is "Secure" (HTTPS-only) by default in production. This deployment serves plain
# HTTP on the private LAN, so docker-compose.prod.yml sets COOKIE_SECURE=false. If you ever put TLS in
# front of the portals, set COOKIE_SECURE=true and list the https:// origins in FRONTEND_URLS.
