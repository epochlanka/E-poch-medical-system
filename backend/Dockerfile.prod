# Production image: compiled JS, production-only node_modules, non-root user.
# Dev keeps using ./Dockerfile (ts-node + hot reload) — this is only for real deployment.

FROM node:20-alpine AS builder
WORKDIR /usr/src/app
RUN apk add --no-cache openssl

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx prisma generate
RUN npm run build

# ---

FROM node:20-alpine
WORKDIR /usr/src/app
RUN apk add --no-cache openssl wget su-exec postgresql17-client

ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /usr/src/app/node_modules/@prisma ./node_modules/@prisma
COPY prisma ./prisma

COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

RUN mkdir -p uploads backups logs \
  && addgroup -S appgroup && adduser -S appuser -G appgroup \
  && chown -R appuser:appgroup /usr/src/app
# Stays root here — the entrypoint chowns the (possibly bind-mounted) uploads/backups/logs
# dirs at boot and drops to appuser via su-exec before actually running the app.

EXPOSE 3000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "dist/server.js"]
