generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Family {
  family_id       Int      @id @default(autoincrement())
  family_name     String
  head_patient_id String?
  address         String?
  city            String?
  family_type     String? // e.g. Nuclear Family, Extended Family, Single Parent, Joint Family, Other — free-text, not enforced against a fixed list
  contact_no      String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  patients     Patient[] @relation("FamilyPatients")
  head_patient Patient?  @relation("FamilyHead", fields: [head_patient_id], references: [patient_id])

  @@index([family_name])
}

model Patient {
  patient_id   String   @id
  family_id    Int
  nic          String?  @unique
  guardian_nic String?
  full_name    String
  dob          DateTime
  gender       String
  phone        String?
  blood_group  String?
  allergies    String?
  photo_url    String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  // Additional intake fields captured by the Register New Patient wizard (receptionist-frontend).
  nationality             String?
  marital_status          String?
  occupation              String?
  employer_school         String?
  relationship_to_head    String? // e.g. Spouse/Child/Parent/Other — free-text, not enforced against a fixed list
  chronic_conditions      String? // free-text, captured at registration per FR-013
  current_medications     String? // free-text, captured at registration alongside allergies/chronic conditions
  emergency_contact_name  String?
  emergency_contact_phone String?

  family      Family   @relation("FamilyPatients", fields: [family_id], references: [family_id])
  family_head Family[] @relation("FamilyHead")

  appointments               Appointment[]
  invoices                   Invoice[]
  change_logs                PatientChangeLog[]
  duplicate_flags_as_new     PatientDuplicateFlag[]         @relation("NewPatientFlags")
  duplicate_flags_as_matched PatientDuplicateFlag[]         @relation("MatchedPatientFlags")
  lab_test_orders            LabTestOrder[]
  external_medicines         ExternalPrescriptionMedicine[]
  issued_letters             IssuedLetter[]

  @@index([full_name])
  @@index([phone])
  @@index([guardian_nic, dob])
}

model PatientChangeLog {
  id         Int      @id @default(autoincrement())
  patient_id String
  field      String
  old_value  String?
  new_value  String?
  reason     String?
  changed_by Int
  changed_at DateTime @default(now())

  patient         Patient @relation(fields: [patient_id], references: [patient_id])
  changed_by_user User    @relation(fields: [changed_by], references: [user_id])

  @@index([patient_id, changed_at])
}

model PatientDuplicateFlag {
  flag_id            Int       @id @default(autoincrement())
  patient_id         String // newly registered patient
  matched_patient_id String // existing patient it fuzzy-matches
  match_reason       String
  status             String    @default("Pending") // Pending, Dismissed, Merged
  reviewed_by        Int?
  reviewed_at        DateTime?
  created_at         DateTime  @default(now())

  patient         Patient @relation("NewPatientFlags", fields: [patient_id], references: [patient_id])
  matched_patient Patient @relation("MatchedPatientFlags", fields: [matched_patient_id], references: [patient_id])
  reviewer        User?   @relation(fields: [reviewed_by], references: [user_id])

  @@index([status])
}

model Appointment {
  appointment_id    Int       @id @default(autoincrement())
  // Nullable: a temporary/unregistered walk-in (is_temporary=true) has no Patient row at all —
  // never fabricate a stub Patient just to satisfy this FK. Permanent appointments always set this.
  patient_id        String?
  doctor_id         Int
  scheduled_at      DateTime
  reason            String? // reason for visit, captured at booking time
  status            String    @default("Waiting") // Waiting, Called, Consulting, Completed, Skipped, Cancelled, No Show
  skip_reason       String? // captured when a doctor skips a called-but-unresponsive patient (FR-029); cleared on recall
  skipped_at        DateTime? // when the skip happened; cleared alongside skip_reason on recall
  is_walk_in        Boolean   @default(false) // true if added directly to today's queue without a pre-booked slot (FR-026)
  consultation_type String? // e.g. General Consultation, Specialist Consultation, Emergency — free-text, not enforced against a fixed list
  visit_type        String    @default("Appointment") // Appointment | Follow-up — booking-time categorization, independent of is_walk_in
  priority          String    @default("Normal") // Normal, Urgent, Emergency — triage priority captured at booking/walk-in time
  notes             String? // internal receptionist notes, distinct from `reason` (the patient-facing reason for visit)
  created_by        Int

  // Today-only walk-in that opted out of permanent registration ("Continue Without Registration").
  // patient_id stays null for the life of the visit unless a receptionist later converts it via
  // convertToPatient (required before billing, since Invoice.patient_id is a hard FK). Minimal
  // capture only — no DOB/NIC/family, since the whole point is skipping full registration.
  is_temporary        Boolean @default(false)
  temp_patient_name   String?
  temp_patient_gender String?
  temp_patient_phone  String?
  temp_patient_age    Int?

  patient      Patient? @relation(fields: [patient_id], references: [patient_id])
  doctor       User     @relation("DoctorAppointments", fields: [doctor_id], references: [user_id])
  receptionist User     @relation("ReceptionistAppointments", fields: [created_by], references: [user_id])

  consultation   Consultation?
  queue_logs     AppointmentQueueLog[]
  issued_letters IssuedLetter[]
}

// Append-only audit trail of Skip/Recall events (Skip / Recall Log page) — separate from the
// live skip_reason/skipped_at columns on Appointment above, which only ever describe the
// *current* skip and are cleared on recall (fine for the live queue board, but a historical log
// needs every past event retained), same "log table alongside a mutable current-state field"
// pattern as ConsultationAmendmentLog.
model AppointmentQueueLog {
  log_id         Int      @id @default(autoincrement())
  appointment_id Int
  action         String // Skipped | Recalled
  reason         String? // required for Skipped at the API layer; optional for Recalled
  actor_id       Int
  created_at     DateTime @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])
  actor       User        @relation(fields: [actor_id], references: [user_id])

  @@index([appointment_id, created_at])
}

model Consultation {
  consultation_id            Int       @id @default(autoincrement())
  appointment_id             Int       @unique
  vitals_json                String?
  allergies_ack              Boolean   @default(false)
  complaint                  String?
  history_of_present_illness String?
  examination_findings       String?
  medical_history_json       String?
  diagnosis                  String?
  icd10_code                 String?
  notes                      String?
  follow_up_date             DateTime?
  status                     String    @default("Draft") // Draft, Finalized
  created_at                 DateTime  @default(now())
  finalized_at               DateTime?
  // Resolved and frozen the moment this consultation is finalized: the doctor's manually-entered
  // fee for THIS visit if they provided one, otherwise ClinicSettings.default_consultation_fee at
  // that instant. Never a permanent per-doctor setting, and never re-resolved later — a later
  // change to the admin default must not alter what an already-finalized consultation charged
  // (Invoice/InvoiceItem read this value, not ClinicSettings, once it's set).
  consultation_fee           Float?

  appointment     Appointment                @relation(fields: [appointment_id], references: [appointment_id])
  prescriptions   Prescription[]
  amendments      ConsultationAmendmentLog[]
  invoices        Invoice[]
  documents       ConsultationDocument[]
  lab_test_orders LabTestOrder[]
  issued_letters  IssuedLetter[]
}

model ConsultationDocument {
  document_id     Int      @id @default(autoincrement())
  consultation_id Int
  filename        String
  original_name   String
  mime_type       String
  size_bytes      Int
  uploaded_by     Int
  uploaded_at     DateTime @default(now())

  consultation Consultation @relation(fields: [consultation_id], references: [consultation_id])
  uploader     User         @relation(fields: [uploaded_by], references: [user_id])

  @@index([consultation_id])
}

model ConsultationAmendmentLog {
  id              Int      @id @default(autoincrement())
  consultation_id Int
  field           String
  old_value       String?
  new_value       String?
  reason          String
  amended_by      Int
  amended_at      DateTime @default(now())

  consultation    Consultation @relation(fields: [consultation_id], references: [consultation_id])
  amended_by_user User         @relation(fields: [amended_by], references: [user_id])

  @@index([consultation_id, amended_at])
}

model Prescription {
  prescription_id Int      @id @default(autoincrement())
  consultation_id Int
  status          String   @default("Pending") // Pending, Preparing, Dispensed, Collected
  is_refill       Boolean  @default(false)
  refill_of_id    Int?
  notes           String? // free-text instructions for the pharmacist, e.g. counseling points
  issued_at       DateTime @default(now())

  consultation       Consultation                   @relation(fields: [consultation_id], references: [consultation_id])
  items              PrescriptionItem[]
  refill_of          Prescription?                  @relation("PrescriptionRefill", fields: [refill_of_id], references: [prescription_id])
  refills            Prescription[]                 @relation("PrescriptionRefill")
  external_medicines ExternalPrescriptionMedicine[]
}

model PrescriptionItem {
  rx_item_id              Int       @id @default(autoincrement())
  prescription_id         Int
  medicine_id             Int
  dosage                  String
  frequency               String?
  duration                String?
  route                   String?
  instructions            String? // per-medicine note distinct from dosage/frequency, e.g. "after food"
  // Units taken per administration, in the medicine's dispensing (base) unit — e.g. 2 tablets, 5 ml.
  // `dosage` above is free text (usually the STRENGTH, "500 mg"), so it can never drive a quantity;
  // this is the explicit number the quantity is calculated from. Null on lines where the schedule
  // isn't calculable (PRN, "Ongoing", free text) or the qty was deliberately entered by hand.
  dose_qty                Float?
  // True when the clinician deliberately entered qty instead of accepting the calculated one.
  qty_manual              Boolean   @default(false)
  qty                     Int
  external_qty            Int       @default(0) // portion of qty sourced externally — 0 = fully clinic, qty = fully external, else split
  dispensed_qty           Int       @default(0) // cumulative qty drawn from clinic stock across partial dispenses; item is complete once dispensed_qty + external_qty >= qty
  batch_id                Int? // last batch that completed this item (kept for label/legacy display) — full per-batch trail lives in `dispenses`
  substituted_medicine_id Int?
  fefo_override_reason    String?
  dispensed_by            Int?
  dispensed_at            DateTime? // set only once the item is FULLY handled (dispensed_qty + external_qty >= qty) — every other module treats this as the binary "done" signal

  prescription         Prescription               @relation(fields: [prescription_id], references: [prescription_id])
  medicine             Medicine                   @relation(fields: [medicine_id], references: [medicine_id])
  batch                Batch?                     @relation(fields: [batch_id], references: [batch_id])
  substituted_medicine Medicine?                  @relation("SubstitutedInItem", fields: [substituted_medicine_id], references: [medicine_id])
  dispensed_by_user    User?                      @relation(fields: [dispensed_by], references: [user_id])
  invoice_items        InvoiceItem[]
  dispenses            PrescriptionItemDispense[]
}

// One row per partial-dispense event for a single prescription line — a line can be topped up
// from a different batch each visit (e.g. the first batch runs out mid-way), so this is the only
// place that records exactly which batch supplied which quantity and when. PrescriptionItem's own
// batch_id/dispensed_by/dispensed_at stay as the "last completing draw" for places that only care
// whether the line is done (billing, queue, reports) — never as the full audit trail.
model PrescriptionItemDispense {
  dispense_id          Int      @id @default(autoincrement())
  rx_item_id           Int
  batch_id             Int
  qty                  Int
  // Snapshotted from the batch at the moment of dispensing — billing invoice-creation reads
  // these (not live Medicine/Batch pricing) so a later price change never rewrites history, and
  // profit-per-sale stays accurate even when the same medicine has batches at different costs.
  unit_price           Float    @default(0) // batch.selling_price_per_base_unit at dispense time — what the patient is charged per unit
  unit_cost            Float    @default(0) // batch.cost_per_base_unit at dispense time — for profit reporting
  fefo_override_reason String?
  notes                String?
  dispensed_by         Int
  dispensed_at         DateTime @default(now())

  item              PrescriptionItem @relation(fields: [rx_item_id], references: [rx_item_id])
  batch             Batch            @relation(fields: [batch_id], references: [batch_id])
  dispensed_by_user User             @relation(fields: [dispensed_by], references: [user_id])
  invoice_item      InvoiceItem?

  @@index([rx_item_id])
}

model Medicine {
  medicine_id           Int     @id @default(autoincrement())
  name                  String
  generic_name          String?
  brand_name            String? // e.g. "Panadol" for generic "Paracetamol" — searchable, distinct from name. Same generic + different brand/strength/form is a separate Medicine row by design (never one row with a brand list).
  category              String? // doubles as "Therapeutic Class" wherever that's shown
  form                  String? // doubles as "Dosage Form" wherever that's shown — Tablet, Capsule, Syrup, Suspension, Cream, Ointment, Drops, Injection, ...
  strength              String? // e.g. "500mg", "10mg/5ml"
  manufacturer          String?
  requires_prescription Boolean @default(false)
  // The atomic unit every batch's stock and every price-per-unit figure is expressed in —
  // Tablet/Capsule for solids, ml for liquids (syrup/suspension/drops/injection), Gram for
  // creams/ointments sold by weight, Piece for anything else. Batches may be RECEIVED in a
  // different pack unit (Box/Strip/Bottle/Tube) and converted down to this via their own
  // units_per_pack — see Batch below.
  base_unit             String  @default("Piece")
  // Prefill only for the "Add Stock Batch" form, e.g. default_pack_unit "Box" + default_pack_size
  // 100 for a medicine normally bought as boxes of 100 tablets. Never authoritative — each batch
  // records its own received_unit/units_per_pack because a given shipment can still arrive loose.
  default_pack_unit     String?
  default_pack_size     Float?
  // Fallback reference price only — shown when there's no batch to price from yet (a brand-new
  // catalog entry, or a fully-external prescription line). Real dispenses/sales always price off
  // the specific Batch they draw from (Batch.selling_price_per_base_unit), never this field.
  default_selling_price Float   @default(0)
  reorder_level         Int     @default(0) // "Min Stock" — reorder trigger threshold, in base units
  max_stock_level       Int     @default(0) // "Max Stock" — target ceiling for reorder-quantity suggestions, in base units
  barcode               String? @unique // doubles as "Medicine Code" wherever that's shown
  is_active             Boolean @default(true)

  batches                    Batch[]
  purchaseOrderItems         PurchaseOrderItem[]
  prescriptionItems          PrescriptionItem[]
  substitutedInItems         PrescriptionItem[]             @relation("SubstitutedInItem")
  substitutionsAsOriginal    MedicineSubstitution[]         @relation("SubstitutionOriginal")
  substitutionsAsAlternative MedicineSubstitution[]         @relation("SubstitutionAlternative")
  externalPrescriptionRefs   ExternalPrescriptionMedicine[]
  invoiceItems               InvoiceItem[]

  @@index([name])
  @@index([generic_name])
  @@index([category])
}

// A doctor-entered "buy this outside the clinic" line — deliberately decoupled from
// PrescriptionItem/Medicine: medicine_id is optional because the item may not exist in the
// clinic's Medicine Master at all (e.g. a specific cream/brand/supplement). This is additive to,
// not a replacement for, PrescriptionItem.external_qty (which splits a real clinic-stocked
// medicine between clinic dispensing and external purchase due to a stock shortfall — a
// different concept from "the doctor wants this specific external item regardless of stock").
model ExternalPrescriptionMedicine {
  ext_item_id     Int      @id @default(autoincrement())
  prescription_id Int
  patient_id      String // denormalized for fast patient-history queries without a join chain
  doctor_id       Int
  medicine_id     Int? // set when sourced from the Medicine Master; null for a manually-typed item
  medicine_name   String
  generic_name    String?
  brand_name      String?
  dosage_form     String
  strength        String?
  dosage          String
  frequency       String?
  duration        String?
  quantity        Int
  quantity_unit   String
  instructions    String? // ';'-joined chips, same encoding as PrescriptionItem.instructions
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  prescription Prescription @relation(fields: [prescription_id], references: [prescription_id])
  patient      Patient      @relation(fields: [patient_id], references: [patient_id])
  doctor       User         @relation(fields: [doctor_id], references: [user_id])
  medicine     Medicine?    @relation(fields: [medicine_id], references: [medicine_id])

  @@index([patient_id])
  @@index([prescription_id])
}

// A doctor-facing catalog of orderable investigations — powers the Add Lab Test search/suggested-
// tests list, and each entry's LabTestParameter children drive the dynamic manual-result-entry
// table (a test's expected parameters, e.g. FBC -> Haemoglobin/WBC/Platelets/...).
model LabTestCatalog {
  test_id      Int     @id @default(autoincrement())
  test_name    String
  test_code    String? @unique
  category     String?
  abbreviation String?
  is_active    Boolean @default(true)

  parameters LabTestParameter[]
  orders     LabTestOrder[]

  @@index([test_name])
  @@index([category])
}

model LabTestParameter {
  parameter_id    Int     @id @default(autoincrement())
  test_id         Int
  parameter_name  String
  unit            String?
  reference_range String? // e.g. "13-17" — parsed for the Normal/Low/High decision-support flag
  display_order   Int     @default(0)
  data_type       String  @default("Numeric") // Numeric, Text
  is_active       Boolean @default(true)

  test    LabTestCatalog @relation(fields: [test_id], references: [test_id])
  results LabResult[]

  @@index([test_id])
}

model LabTestOrder {
  lab_test_order_id Int      @id @default(autoincrement())
  patient_id        String
  doctor_id         Int
  consultation_id   Int
  catalog_test_id   Int? // set when ordered from the catalog; null for a free-typed test not in it
  test_name         String
  test_category     String?
  instructions      String?
  priority          String   @default("Routine") // Routine, Urgent, STAT
  additional_notes  String?
  request_number    String?  @unique
  status            String   @default("Pending") // Pending, Report Received, Completed, Cancelled
  order_date        DateTime @default(now())

  printed_at         DateTime? // audit only — printing never changes status (FR-request-11)
  printed_by         Int?
  report_received_at DateTime? // "the physical report is back", no clinical values yet
  report_received_by Int?
  received_note      String?

  interpretation String? // doctor's clinical interpretation, entered together with completion
  completed_at   DateTime?
  completed_by   Int?

  // Legacy single-field result columns from the original result-entry flow — kept for any
  // pre-existing rows, superseded by the per-parameter LabResult table for every order going
  // forward through markReportReceived/completeLabResult.
  result_value     String?
  unit             String?
  reference_range  String?
  result_notes     String?
  result_date      DateTime?
  laboratory_name  String?
  report_file_path String?
  entered_by       Int?
  entered_at       DateTime?
  reviewed_by      Int?
  review_notes     String?
  reviewed_date    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient                 Patient         @relation(fields: [patient_id], references: [patient_id])
  doctor                  User            @relation("LabTestOrderDoctor", fields: [doctor_id], references: [user_id])
  consultation            Consultation    @relation(fields: [consultation_id], references: [consultation_id])
  catalog_test            LabTestCatalog? @relation(fields: [catalog_test_id], references: [test_id])
  printed_by_user         User?           @relation("LabTestOrderPrintedBy", fields: [printed_by], references: [user_id])
  report_received_by_user User?           @relation("LabTestOrderReceivedBy", fields: [report_received_by], references: [user_id])
  completed_by_user       User?           @relation("LabTestOrderCompletedBy", fields: [completed_by], references: [user_id])
  entered_by_user         User?           @relation("LabTestOrderEnteredBy", fields: [entered_by], references: [user_id])
  reviewed_by_user        User?           @relation("LabTestOrderReviewedBy", fields: [reviewed_by], references: [user_id])
  results                 LabResult[]

  @@index([patient_id])
  @@index([consultation_id])
  @@index([status])
}

// One row per reported parameter for an order (Haemoglobin, WBC, ...) — replaces the single
// flat result_value field so each test can have its own configurable set of results.
model LabResult {
  result_id         Int      @id @default(autoincrement())
  lab_test_order_id Int
  parameter_id      Int?
  parameter_name    String // denormalized snapshot — stays correct even if the catalog changes later
  unit              String?
  reference_range   String?
  result_value      String
  result_flag       String? // Normal, Low, High — decision-support only, never a diagnosis
  entered_by        Int
  entered_at        DateTime @default(now())

  order           LabTestOrder      @relation(fields: [lab_test_order_id], references: [lab_test_order_id])
  parameter       LabTestParameter? @relation(fields: [parameter_id], references: [parameter_id])
  entered_by_user User              @relation("LabResultEnteredBy", fields: [entered_by], references: [user_id])

  @@index([lab_test_order_id])
}

model MedicineSubstitution {
  substitution_id        Int      @id @default(autoincrement())
  medicine_id            Int
  substitute_medicine_id Int
  priority               Int      @default(1) // 1 = first preference; informational ranking only, dispense() does not auto-pick by this
  type                   String   @default("Manual") // Auto | Manual — informational only; dispense() still requires the pharmacist to pick the batch/substitute explicitly either way
  is_active              Boolean  @default(true)
  created_by             Int
  created_at             DateTime @default(now())

  medicine            Medicine @relation("SubstitutionOriginal", fields: [medicine_id], references: [medicine_id])
  substitute_medicine Medicine @relation("SubstitutionAlternative", fields: [substitute_medicine_id], references: [medicine_id])
  creator             User     @relation(fields: [created_by], references: [user_id])

  @@unique([medicine_id, substitute_medicine_id])
}

// One row per stock receipt ("Stock Batch") — a Medicine Product can have many, each keeping its
// own batch number, expiry, supplier, purchase cost and selling price forever (receiving a new
// batch at a different price/expiry never touches an older one). Status (Active/Depleted/Expired)
// is deliberately not a stored column — it's derived live from qty_on_hand/expiry_date, same
// "compute, don't cache" convention as medicine stock status elsewhere in this codebase.
model Batch {
  batch_id                    Int       @id @default(autoincrement())
  medicine_id                 Int
  batch_no                    String
  supplier_id                 Int?
  purchase_date               DateTime  @default(now())
  manufacture_date            DateTime?
  expiry_date                 DateTime
  // The unit this specific receipt was recorded in — Box, Strip, Bottle, Tablet, Capsule, ml,
  // Tube, Piece, Other. Independent of the medicine's default_pack_unit: a shipment can arrive as
  // loose tablets (received_unit "Tablet", units_per_pack 1) even if boxes are the norm.
  received_unit               String    @default("Piece")
  received_qty                Float     @default(0) // quantity in received_unit, e.g. 5 (boxes) or 25 (loose tablets)
  units_per_pack              Float     @default(1) // base units per one received_unit — e.g. 100 tablets/box; 1 if received_unit already is the base unit
  qty_base_total              Float     @default(0) // received_qty * units_per_pack, frozen at receipt — the batch's original size in base units
  qty_on_hand                 Float // remaining stock, in base units (fractional for ml/gram) — decremented by sales/adjustments
  // Purchase (cost) side — never overwritten by, or used to derive, the selling side.
  purchase_price_per_pack     Float     @default(0) // price paid per received_unit
  cost_per_base_unit          Float     @default(0) // purchase_price_per_pack / units_per_pack, frozen at receipt
  // Selling side — never overwritten by, or used to derive, the purchase side.
  selling_price_per_pack      Float? // optional — price charged when sold as a whole received_unit pack
  selling_price_per_base_unit Float     @default(0) // drives per-base-unit sales/dispensing (FEFO draws always charge this)
  location                    String? // physical storage location, e.g. "Main Store / Shelf A-01"

  medicine          Medicine                   @relation(fields: [medicine_id], references: [medicine_id])
  supplier          Supplier?                  @relation(fields: [supplier_id], references: [supplier_id])
  prescriptionItems PrescriptionItem[]
  item_dispenses    PrescriptionItemDispense[]
  ledger_entries    StockLedger[]
  stock_count_items StockCountItem[]
  grn_item          GRNItem?
  invoiceItems      InvoiceItem[]

  @@index([medicine_id, expiry_date])
}

// Every stock movement ("Stock Transaction"), always tied to the exact batch it moved —
// change_qty/balance_after are always in the medicine's base unit, whatever unit the underlying
// event itself was recorded in (e.g. a 5-box GRN receipt lands here as +500 tablets).
model StockLedger {
  ledger_id      Int      @id @default(autoincrement())
  batch_id       Int
  change_qty     Float // positive = stock in, negative = stock out, in base units
  balance_after  Float // in base units
  event_type     String // OpeningStock, GRN (purchase receipt), Dispense (sale), Adjustment, Transfer, Return, Damaged, Expired, StockTakeCorrection
  unit_price     Float? // batch.selling_price_per_base_unit at the moment of a Dispense — snapshotted for historically-accurate revenue reporting
  unit_cost      Float? // batch.cost_per_base_unit at the moment of the event — snapshotted for historically-accurate profit reporting
  reference_type String?
  reference_id   String?
  reason         String?
  created_by     Int
  created_at     DateTime @default(now())

  batch           Batch @relation(fields: [batch_id], references: [batch_id])
  created_by_user User  @relation(fields: [created_by], references: [user_id])

  @@index([batch_id, created_at])
}

model StockCount {
  stock_count_id Int       @id @default(autoincrement())
  status         String    @default("Draft") // Draft, PendingReview, Posted
  notes          String?
  performed_by   Int
  reviewed_by    Int?
  created_at     DateTime  @default(now())
  posted_at      DateTime?

  performed_by_user User             @relation("StockCountPerformer", fields: [performed_by], references: [user_id])
  reviewed_by_user  User?            @relation("StockCountReviewer", fields: [reviewed_by], references: [user_id])
  items             StockCountItem[]
}

model StockCountItem {
  stock_count_item_id Int   @id @default(autoincrement())
  stock_count_id      Int
  batch_id            Int
  expected_qty        Float
  counted_qty         Float
  variance            Float

  stock_count StockCount @relation(fields: [stock_count_id], references: [stock_count_id])
  batch       Batch      @relation(fields: [batch_id], references: [batch_id])

  @@index([stock_count_id])
}

model Supplier {
  supplier_id        Int     @id @default(autoincrement())
  name               String
  contact            String? // legacy free-text contact field, superseded by the structured fields below
  contact_person     String?
  phone              String?
  email              String?
  city               String?
  payment_terms_days Int     @default(30) // used to flag received-but-unpaid orders as overdue
  address            String?
  is_active          Boolean @default(true)

  batches        Batch[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
}

model PurchaseOrder {
  po_id         Int       @id @default(autoincrement())
  supplier_id   Int
  order_date    DateTime
  expected_date DateTime? // expected delivery date, set at booking time
  status        String    @default("Draft") // Draft, Submitted, PartiallyReceived, Received, Closed, Cancelled
  created_by    Int
  created_at    DateTime  @default(now())

  supplier Supplier            @relation(fields: [supplier_id], references: [supplier_id])
  creator  User                @relation(fields: [created_by], references: [user_id])
  items    PurchaseOrderItem[]
  grns     GoodsReceivedNote[]
}

model PurchaseOrderItem {
  po_item_id  Int    @id @default(autoincrement())
  po_id       Int
  medicine_id Int
  qty_ordered Float
  unit_cost   Float? // estimated purchase price per pack unit at order time — the batch created at GRN receipt records its own actual purchase_price_per_pack, which may differ

  purchase_order PurchaseOrder @relation(fields: [po_id], references: [po_id])
  medicine       Medicine      @relation(fields: [medicine_id], references: [medicine_id])
  grn_items      GRNItem[]
}

model GoodsReceivedNote {
  grn_id                  Int       @id @default(autoincrement())
  po_id                   Int
  received_by             Int
  received_at             DateTime  @default(now())
  has_discrepancy         Boolean   @default(false)
  discrepancy_reviewed_by Int?
  discrepancy_reviewed_at DateTime?
  discrepancy_notes       String?

  purchase_order PurchaseOrder @relation(fields: [po_id], references: [po_id])
  receiver       User          @relation("GRNReceiver", fields: [received_by], references: [user_id])
  reviewer       User?         @relation("GRNReviewer", fields: [discrepancy_reviewed_by], references: [user_id])
  items          GRNItem[]
}

model GRNItem {
  grn_item_id  Int   @id @default(autoincrement())
  grn_id       Int
  po_item_id   Int
  batch_id     Int?  @unique
  qty_received Float

  grn     GoodsReceivedNote @relation(fields: [grn_id], references: [grn_id])
  po_item PurchaseOrderItem @relation(fields: [po_item_id], references: [po_item_id])
  batch   Batch?            @relation(fields: [batch_id], references: [batch_id])
}

model Invoice {
  invoice_id      Int       @id @default(autoincrement())
  // Nullable: an unregistered walk-in (Appointment.is_temporary) has no Patient row — never
  // fabricate a stub Patient just to satisfy this FK. The display name/phone for such an invoice
  // is derived at read time from the visit's Appointment.temp_patient_* fields (see
  // resolveDisplayPatient in billing/service.ts) rather than duplicated here. Backfilled to the
  // real patient_id if the walk-in later registers (see appointments.convertToPatient).
  patient_id      String?
  consultation_id Int?
  subtotal        Float     @default(0)
  discount_total  Float     @default(0)
  total_amount    Float     @default(0)
  paid_amount     Float     @default(0)
  payment_status  String    @default("Outstanding") // Outstanding, PartiallyPaid, Paid, Voided
  created_via     String    @default("Manual") // Manual, Auto — Auto means the system generated this when the visit completed
  void_reason     String?
  voided_by       Int?
  voided_at       DateTime?
  created_by      Int
  created_at      DateTime  @default(now())

  patient        Patient?      @relation(fields: [patient_id], references: [patient_id])
  consultation   Consultation? @relation(fields: [consultation_id], references: [consultation_id])
  creator        User          @relation("InvoiceCreator", fields: [created_by], references: [user_id])
  voided_by_user User?         @relation("InvoiceVoider", fields: [voided_by], references: [user_id])
  items          InvoiceItem[]
  payments       Payment[]
  refunds        Refund[]

  @@index([created_at])
}

model InvoiceItem {
  invoice_item_id             Int     @id @default(autoincrement())
  invoice_id                  Int
  item_type                   String // ConsultationFee, Medicine, Discount
  description                 String
  qty                         Int     @default(1)
  unit_price                  Float
  line_total                  Float
  source_prescription_item_id Int?
  // Medicine lines only — the exact product/batch this line was priced and deducted from.
  // ConsultationFee/Discount lines leave these null.
  medicine_id                 Int?
  batch_id                    Int?
  // The exact PrescriptionItemDispense this line bills for — one line per batch actually drawn
  // (never a weighted-average across batches), and the unique constraint makes billing a given
  // dispense idempotent: a later top-up sync can find "already-billed" dispenses by this FK and
  // never double-charge the same batch draw twice.
  source_dispense_id          Int?    @unique
  base_qty                    Float? // qty in the medicine's base unit (matches the dispense's batch draw)
  unit                        String? // snapshot of medicine.base_unit at billing time
  purchase_cost               Float? // total cost for this line, from the batch's cost_per_base_unit — for profit reporting only, never shown to the patient
  profit                      Float? // line_total - purchase_cost

  invoice         Invoice                   @relation(fields: [invoice_id], references: [invoice_id])
  source_item     PrescriptionItem?         @relation(fields: [source_prescription_item_id], references: [rx_item_id])
  medicine        Medicine?                 @relation(fields: [medicine_id], references: [medicine_id])
  batch           Batch?                    @relation(fields: [batch_id], references: [batch_id])
  source_dispense PrescriptionItemDispense? @relation(fields: [source_dispense_id], references: [dispense_id])
}

model Payment {
  payment_id      Int      @id @default(autoincrement())
  invoice_id      Int
  method          String // Cash, Card, Mobile, or any active PaymentMethod master-data entry
  amount          Float
  idempotency_key String?  @unique // client-generated key — a replayed request with the same key returns the original payment instead of double-charging
  received_by     Int
  received_at     DateTime @default(now())

  invoice  Invoice @relation(fields: [invoice_id], references: [invoice_id])
  receiver User    @relation(fields: [received_by], references: [user_id])

  @@index([received_at])
}

// A void on an invoice that already collected money must account for where that money went —
// this is the only place in the schema that records money leaving, mirroring Payment for money in.
model Refund {
  refund_id  Int      @id @default(autoincrement())
  invoice_id Int
  method     String
  amount     Float
  reason     String?
  issued_by  Int
  issued_at  DateTime @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [invoice_id])
  issuer  User    @relation(fields: [issued_by], references: [user_id])

  @@index([issued_at])
}

model User {
  user_id             Int     @id @default(autoincrement())
  role                String // Admin, Receptionist, Doctor, Pharmacist
  username            String  @unique
  password_hash       String
  registration_number String?
  is_active           Boolean @default(true)

  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  totp_secret  String?
  totp_enabled Boolean @default(false)
  // A replacement/first secret that has been generated but NOT yet proven. Promoted to totp_secret
  // only when /2fa/verify succeeds, so starting a re-enrolment never weakens an already-active 2FA.
  totp_pending_secret String?

  last_login_at DateTime?

  doctor_appointments           Appointment[]                  @relation("DoctorAppointments")
  receptionist_appointments     Appointment[]                  @relation("ReceptionistAppointments")
  purchase_orders               PurchaseOrder[]
  audit_logs                    AuditLog[]
  patient_change_logs           PatientChangeLog[]
  reviewed_duplicate_flags      PatientDuplicateFlag[]
  consultation_amendments       ConsultationAmendmentLog[]
  medicine_substitutions        MedicineSubstitution[]
  dispensed_items               PrescriptionItem[]
  prescription_item_dispenses   PrescriptionItemDispense[]
  stock_ledger_entries          StockLedger[]
  stock_counts_performed        StockCount[]                   @relation("StockCountPerformer")
  stock_counts_reviewed         StockCount[]                   @relation("StockCountReviewer")
  grns_received                 GoodsReceivedNote[]            @relation("GRNReceiver")
  grns_reviewed                 GoodsReceivedNote[]            @relation("GRNReviewer")
  invoices_created              Invoice[]                      @relation("InvoiceCreator")
  invoices_voided               Invoice[]                      @relation("InvoiceVoider")
  payments_received             Payment[]
  refunds_issued                Refund[]
  settings_updates              ClinicSettings[]
  backups_created               DbBackup[]
  sessions                      UserSession[]
  consultation_documents        ConsultationDocument[]
  queue_log_actions             AppointmentQueueLog[]
  lab_test_orders_ordered       LabTestOrder[]                 @relation("LabTestOrderDoctor")
  lab_test_orders_entered       LabTestOrder[]                 @relation("LabTestOrderEnteredBy")
  lab_test_orders_reviewed      LabTestOrder[]                 @relation("LabTestOrderReviewedBy")
  lab_test_orders_printed       LabTestOrder[]                 @relation("LabTestOrderPrintedBy")
  lab_test_orders_received      LabTestOrder[]                 @relation("LabTestOrderReceivedBy")
  lab_test_orders_completed     LabTestOrder[]                 @relation("LabTestOrderCompletedBy")
  lab_results_entered           LabResult[]                    @relation("LabResultEnteredBy")
  external_medicines_prescribed ExternalPrescriptionMedicine[]
  letter_templates_created      LetterTemplate[]               @relation("LetterTemplateCreator")
  letter_templates_updated      LetterTemplate[]               @relation("LetterTemplateUpdater")
  letter_template_versions      LetterTemplateVersion[]        @relation("LetterTemplateVersionUploader")
  issued_letters                IssuedLetter[]
}

model UserSession {
  session_id       Int       @id @default(autoincrement())
  user_id          Int
  created_at       DateTime  @default(now())
  last_activity_at DateTime  @default(now())
  revoked_at       DateTime?
  user_agent       String?
  ip_address       String?

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
}

model AuditLog {
  log_id    Int      @id @default(autoincrement())
  user_id   Int?
  action    String
  entity    String
  entity_id String
  timestamp DateTime @default(now())

  user User? @relation(fields: [user_id], references: [user_id])
}

model ClinicSettings {
  id                          Int      @id @default(1)
  clinic_name                 String   @default("MediCare Clinic & Dispensary")
  clinic_address              String?
  registration_number         String?
  logo_url                    String?
  default_consultation_fee    Float    @default(500)
  expiry_alert_threshold_days Int      @default(90)
  session_timeout_minutes     Int      @default(15)
  account_lockout_minutes     Int      @default(15)
  updated_by                  Int?
  updated_at                  DateTime @updatedAt

  updater User? @relation(fields: [updated_by], references: [user_id])
}

// ---- Doctor Letter Management (DOCX-based) ---------------------------------------------
// Admin designs each letter in Microsoft Word and uploads the .docx (one upload = one
// LetterTemplateVersion). The system fills {{PLACEHOLDER}} tokens by editing the DOCX XML
// in place and renders to PDF with LibreOffice, so the admin's exact formatting — fonts,
// colours, header/footer, logos, borders, tables, stamp areas, page size/orientation — is
// preserved. The letterhead columns below feed the {{CLINIC_*}} / {{DOCTOR_*}} / {{PHONE}} /
// {{REGISTRATION_NO}} placeholders and are the ONLY letter content code ever supplies;
// everything else lives inside the .docx and is never generated or appended by the system.
model LetterTemplate {
  letter_template_id Int     @id @default(autoincrement())
  name               String // e.g. "Medical Certificate" — shown to the doctor as-is
  letter_type        String  @default("General") // free text; the UI offers common suggestions
  is_active          Boolean @default(true)

  // The version currently served to doctors. Older versions stay in `versions` and remain
  // referenced by any letter already issued from them, so history stays reproducible.
  current_version_id Int? @unique

  // Letterhead values substituted into placeholders. All optional — an admin may instead
  // hard-code them directly in the Word document and simply not use the placeholder.
  clinic_name          String?
  clinic_address       String?
  phone_number         String?
  doctor_name          String?
  doctor_qualification String?
  doctor_department    String?
  registration_number  String?

  created_by Int
  created_at DateTime @default(now())
  updated_by Int?
  updated_at DateTime @updatedAt

  creator         User                    @relation("LetterTemplateCreator", fields: [created_by], references: [user_id])
  updater         User?                   @relation("LetterTemplateUpdater", fields: [updated_by], references: [user_id])
  current_version LetterTemplateVersion?  @relation("CurrentVersion", fields: [current_version_id], references: [version_id])
  versions        LetterTemplateVersion[] @relation("TemplateVersions")
  issued_letters  IssuedLetter[]
}

// One uploaded .docx. "Replace template" creates a new row with an incremented
// version_number and repoints LetterTemplate.current_version_id — it never mutates or
// deletes an existing version, so letters issued from an older version stay reproducible.
model LetterTemplateVersion {
  version_id              Int      @id @default(autoincrement())
  letter_template_id      Int
  version_number          Int
  docx_filename           String // stored under uploads/letter-templates/
  original_filename       String // the admin's own filename, e.g. "Medical Certificate.docx"
  placeholder_report_json String // { found: string[], unknown: string[], missingBody: boolean } captured at upload
  uploaded_by             Int
  uploaded_at             DateTime @default(now())

  template       LetterTemplate  @relation("TemplateVersions", fields: [letter_template_id], references: [letter_template_id], onDelete: Cascade)
  current_for    LetterTemplate? @relation("CurrentVersion")
  uploader       User            @relation("LetterTemplateVersionUploader", fields: [uploaded_by], references: [user_id])
  issued_letters IssuedLetter[]

  @@unique([letter_template_id, version_number])
}

// A fully frozen record of one issued letter: the filled .docx and its rendered PDF are
// written to disk once, at issue time, and served back verbatim forever after. A later
// template edit, replace, or delete therefore cannot alter a letter a patient already
// received. Only created for a registered patient (real patient_id, not is_temporary) — a
// temporary walk-in's letter is generated and streamed but never persisted here.
model IssuedLetter {
  issued_letter_id    Int    @id @default(autoincrement())
  letter_template_id  Int?
  template_version_id Int?
  patient_id          String
  appointment_id      Int?
  consultation_id     Int?

  letter_type_name      String
  doctor_id             Int
  doctor_name_snapshot  String
  letter_body           String // the doctor-entered {{LETTER_BODY}} text
  placeholder_data_json String // every value substituted into the document, snapshotted
  docx_filename         String // frozen filled .docx, uploads/issued-letters/
  pdf_filename          String // frozen rendered PDF,  uploads/issued-letters/

  issued_at DateTime @default(now())

  template     LetterTemplate?        @relation(fields: [letter_template_id], references: [letter_template_id], onDelete: SetNull)
  version      LetterTemplateVersion? @relation(fields: [template_version_id], references: [version_id], onDelete: SetNull)
  patient      Patient                @relation(fields: [patient_id], references: [patient_id])
  appointment  Appointment?           @relation(fields: [appointment_id], references: [appointment_id])
  consultation Consultation?          @relation(fields: [consultation_id], references: [consultation_id])
  doctor       User                   @relation(fields: [doctor_id], references: [user_id])

  @@index([patient_id])
}

model MasterDataItem {
  item_id    Int     @id @default(autoincrement())
  type       String // MedicineCategory, PaymentMethod, DiscountType
  value      String
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  @@unique([type, value])
  @@index([type])
}

model DbBackup {
  backup_id   Int       @id @default(autoincrement())
  filename    String    @unique
  size_bytes  Int
  created_by  Int
  created_at  DateTime  @default(now())
  verified    Boolean   @default(false)
  verified_at DateTime?

  creator User @relation(fields: [created_by], references: [user_id])
}
